y is it try to upload all video to it server on /public or storage if configure it should use system temp local storage to store file so server don\\'t take load and run this smooth and no storage is needed and upload immediately and also other feature also should work make this hybrid system don\\'t remove /public folder fallback or r2 storage if configure just add env that tell local_store if true it store on user own computer temp storage if not it use server base config\"\\n\\nWe need to look at upload-related files. There is `src/hooks/use-upload.ts`, `src\\\\lib\\\\queue\\\\workers\\\\upload-worker.ts`, `src\\\\app\\\\dashboard\\\\upload\\\\actions.ts`, and route files under `src\\\\app\\\\api\\\\upload\\\\init\\\\route.ts` and `finalize\\\\route.ts`.\\n\\nWe should examine these to see the current implementation and identify issues.\\n\\nLet\\'s read them.\\n\\n', 'tool_calls': [{'id': 'chatcmpl-tool-adccea12668a755f', 'type': 'function', 'function': {'name': 'Read', 'arguments': '{\"file_path\": \"D:\\\\\\\\Code\\\\\\\\yout\\\\\\\\src\\\\\\\\hooks\\\\\\\\use-upload.ts\"}'}}]}, {'role': 'tool', 'tool_call_id': 'chatcmpl-tool-adccea12668a755f', 'content': '1\\t\"use client\"\\n2\\t\\n3\\timport { useState } from \"react\"\\n4\\timport { toast } from \"sonner\"\\n5\\t\\n6\\texport interface UploadProgress {\\n7\\t  fileName: string\\n8\\t  progress: number\\n9\\t  status: \"uploading\" | \"completed\" | \"error\"\\n10\\t}\\n11\\t\\n12\\texport function useUpload() {\\n13\\t  const [uploads, setUploads] = useState<Record<string, UploadProgress>>({})\\n14\\t\\n15\\t  const startUpload = (fileName: string) => {\\n16\\t    setUploads(prev => ({\\n17\\t      ...prev,\\n18\\t      [fileName]: { fileName, progress: 0, status: \"uploading\" }\\n19\\t    }))\\n20\\t  }\\n21\\t\\n22\\t  const updateProgress = (fileName: string, progress: number) => {\\n23\\t    setUploads(prev => ({\\n24\\t      ...prev,\\n25\\t      [fileName]: { ...prev[fileName], progress }\\n26\\t    }))\\n27\\t  }\\n28\\t\\n29\\t  const finishUpload = (fileName: string, error?: string) => {\\n30\\t    setUploads(prev => ({\\n31\\t      ...prev,\\n32\\t      [fileName]: { \\n33\\t        ...prev[fileName], \\n34\\t        progress: error ? prev[fileName].progress : 100, \\n35\\t        status: error ? \"error\" : \"completed\" \\n36\\t      }\\n37\\t    }))\\n38\\t    if (error) toast.error(`Upload failed for ${fileName}: ${error}`)\\n39\\t    else toast.success(`Upload complete: ${fileName}`)\\n40\\t  }\\n41\\t\\n42\\t  return {\\n43\\t    uploads,\\n44\\t    startUpload,\\n45\\t    updateProgress,\\n46\\t    finishUpload,\\n47\\t  }\\n48\\t}\\n49\\t'}, {'role': 'assistant', 'content': '', 'reasoning_content': \"We need to see the actual upload API route and any storage config. Let's check upload init and finalize routes.\\n\", 'tool_calls': [{'id': 'chatcmpl-tool-b0df673864c801cc', 'type': 'function', 'function': {'name': 'Read', 'arguments': '{\"file_path\": \"D:\\\\\\\\Code\\\\\\\\yout\\\\\\\\src\\\\\\\\app\\\\\\\\api\\\\\\\\upload\\\\\\\\init\\\\\\\\route.ts\"}'}}]}, {'role': 'tool', 'tool_call_id': 'chatcmpl-tool-b0df673864c801cc', 'content': '1\\timport { NextRequest, NextResponse } from \"next/server\"\\n2\\timport { getServerSession } from \"next-auth\"\\n3\\timport { authOptions } from \"@/lib/auth\"\\n4\\timport { db } from \"@/lib/db\"\\n5\\timport { videos } from \"@/lib/db/schema\"\\n6\\timport { StorageEngine } from \"@/lib/storage\"\\n7\\timport { randomUUID } from \"crypto\"\\n8\\timport { logger } from \"@/lib/logger\"\\n9\\t\\n10\\texport async function POST(request: NextRequest) {\\n11\\t  try {\\n12\\t    const session = await getServerSession(authOptions)\\n13\\t    if (!session?.user?.id) {\\n14\\t      return NextResponse.json({ error: \"Unauthorized\" }, { status: 401 })\\n15\\t    }\\n16\\t\\n17\\t    const { filename, fileType, fileSize, title, description } = await request.json()\\n18\\t\\n19\\t    if (!filename || !fileType) {\\n20\\t      return NextResponse.json({ error: \"Invalid metadata\" }, { status: 400 })\\n21\\t    }\\n22\\t\\n23\\t    logger.info(`Initialising upload for user ${session.user.id}: ${filename} (${formatSize(fileSize)})`)\\n24\\t\\n25\\t    const videoId = randomUUID()\\n26\\t    const storageKey = `${Date.now()}-${filename}`\\n27\\t    \\n28\\t    // Get Pre-signed URL or direct upload path\\n29\\t    logger.debug(`Generating presigned URL for ${storageKey}`)\\n30\\t    const { url } = await StorageEngine.getPresignedUrl(storageKey, fileType)\\n31\\t    const storedPath = StorageEngine.getUrl(storageKey)\\n32\\t\\n33\\t    // Create initial DB record\\n34\\t    logger.debug(`Inserting video record ${videoId} into DB`)\\n35\\t    try {\\n36\\t      await db.insert(videos).values({\\n37\\t        id: videoId,\\n38\\t        userId: session.user.id,\\n39\\t        title: title || filename,\\n40\\t        description: description || \"\",\\n41\\t        filePath: storedPath,\\n42\\t        fileSize: fileSize,\\n43\\t        status: \"draft\",\\n44\\t        // Letting Drizzle handle createdAt/updatedAt defaults for better compatibility\\n45\\t      })\\n46\\t    } catch (dbError: unknown) {\\n47\\t      const message = dbError instanceof Error ? dbError.message : \"protocol initialization failed\";\\n48\\t      logger.error(dbError instanceof Error ? dbError : new Error(message), `DB insertion failed for video ${videoId}: ${message}`);\\n49\\t      throw new Error(`Database synchronization failure: ${message}`);\\n50\\t    }\\n51\\t\\n52\\t    logger.info(`Upload initialized: ${videoId}. Strategy: ${url.includes(\\'api/upload\\') ? \\'Local\\' : \\'Cloud\\'}`)\\n53\\t\\n54\\t    return NextResponse.json({\\n55\\t      success: true,\\n56\\t      videoId,\\n57\\t      uploadUrl: url,\\n58\\t      storedPath\\n59\\t    })\\n60\\t  } catch (error: unknown) {\\n61\\t    const err = error as Error\\n62\\t    logger.error(err, \"Upload Init failure\")\\n63\\t    return NextResponse.json({ \\n64\\t      error: err.message || \"Protocol initialization failed\" \\n65\\t    }, { status: 500 })\\n66\\t  }\\n67\\t}\\n68\\t\\n69\\tfunction formatSize(bytes: number) {\\n70\\t    if (!bytes) return \"0B\"\\n71\\t    const k = 1024\\n72\\t    const sizes = [\"B\", \"KB\", \"MB\", \"GB\"]\\n73\\t    const i = Math.floor(Math.log(bytes) / Math.log(k))\\n74\\t    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + sizes[i]\\n75\\t}\\n76\\t'}, {'role': 'assistant', 'content': '', 'reasoning_content': 'We need to see StorageEngine. Look at src/lib/storage.ts.\\n', 'tool_calls': [{'id': 'chatcmpl-tool-95ad8fe4d9d8723f', 'type': 'function', 'function': {'name': 'Read', 'arguments': '{\"file_path\": \"D:\\\\\\\\Code\\\\\\\\yout\\\\\\\\src\\\\\\\\lib\\\\\\\\storage.ts\"}'}}]}, {'role': 'tool', 'tool_call_id': 'chatcmpl-tool-95ad8fe4d9d8723f', 'content': '1\\timport { S3Client, PutObjectCommand, DeleteObjectCommand } from \"@aws-sdk/client-s3\"\\n2\\timport { getSignedUrl } from \"@aws-sdk/s3-request-presigner\"\\n3\\timport fs from \"fs\"\\n4\\timport path from \"path\"\\n5\\timport { logger } from \"./logger\"\\n6\\timport { getStoragePath } from \"./storage-utils\"\\n7\\t\\n8\\tconst R2_ACCESS_KEY = process.env.R2_ACCESS_KEY\\n9\\tconst R2_SECRET_KEY = process.env.R2_SECRET_KEY\\n10\\tconst R2_BUCKET = process.env.R2_BUCKET\\n11\\tconst R2_ENDPOINT = process.env.R2_ENDPOINT\\n12\\tconst R2_PUBLIC_URL = process.env.R2_PUBLIC_URL?.replace(/\\\\/$/, \"\")\\n13\\t\\n14\\tconst isCloudEnabled = !!(R2_ACCESS_KEY && R2_SECRET_KEY && R2_BUCKET && R2_ENDPOINT)\\n15\\t\\n16\\tconst s3Client = isCloudEnabled ? new S3Client({\\n17\\t  region: \"auto\",\\n18\\t  endpoint: R2_ENDPOINT,\\n19\\t  credentials: {\\n20\\t    accessKeyId: R2_ACCESS_KEY!,\\n21\\t    secretAccessKey: R2_SECRET_KEY!,\\n22\\t  },\\n23\\t}) : null\\n24\\t\\n25\\texport class StorageEngine {\\n26\\t  /**\\n27\\t   * Uploads a file to Cloudflare R2 or local fallback\\n28\\t   * @param filePath Path to the local file to upload\\n29\\t   * @param key Desired key (filename/path) in storage\\n30\\t   * @param contentType MIME type of the file\\n31\\t   */\\n32\\t  static async uploadFile(filePath: string, key: string, contentType?: string): Promise<string> {\\n33\\t    try {\\n34\\t      if (isCloudEnabled && s3Client) {\\n35\\t        logger.info(`Cloud Storage Protocol: Initiating R2 upload for ${key}`)\\n36\\t        \\n37\\t        // Use stream for memory efficiency on large video files\\n38\\t        const fileStream = fs.createReadStream(filePath)\\n39\\t        \\n40\\t        await s3Client.send(new PutObjectCommand({\\n41\\t          Bucket: R2_BUCKET,\\n42\\t          Key: key,\\n43\\t          Body: fileStream,\\n44\\t          ContentType: contentType,\\n45\\t        }))\\n46\\t        \\n47\\t        return key\\n48\\t      } else {\\n49\\t        logger.info(`Local Storage Protocol: Fallback enabled for ${key}`)\\n50\\t        const localDest = getStoragePath(\"uploads\", key)\\n51\\t        const destDir = path.dirname(localDest)\\n52\\t        \\n53\\t        if (!fs.existsSync(destDir)) fs.mkdirSync(destDir, { recursive: true })\\n54\\t        \\n55\\t        // If we are already there (e.g. download worker), skip copy\\n56\\t        if (path.resolve(filePath) !== path.resolve(localDest)) {\\n57\\t           fs.copyFileSync(filePath, localDest)\\n58\\t        }\\n59\\t        \\n60\\t        return key\\n61\\t      }\\n62\\t    } catch (error) {\\n63\\t      logger.error(error, `Storage Engine Failure during upload of ${key}`)\\n64\\t      throw error\\n65\\t    }\\n66\\t  }\\n67\\t\\n68\\t  static async deleteFile(key: string): Promise<void> {\\n69\\t    try {\\n70\\t      if (isCloudEnabled && s3Client) {\\n71\\t        await s3Client.send(new DeleteObjectCommand({\\n72\\t          Bucket: R2_BUCKET,\\n73\\t          Key: key,\\n74\\t        }))\\n75\\t      } else {\\n76\\t        const localPath = getStoragePath(\"uploads\", key)\\n77\\t        if (fs.existsSync(localPath)) fs.unlinkSync(localPath)\\n78\\t      }\\n79\\t    } catch (error) {\\n80\\t      logger.error(error, `Storage Engine Failure during deletion of ${key}`)\\n81\\t    }\\n82\\t  }\\n83\\t\\n84\\t  /**\\n85\\t   * Returns the accessible URL for a stored key\\n86\\t   */\\n87\\t  static getUrl(key: string): string {\\n88\\t    if (isCloudEnabled) {\\n89\\t      return `${R2_PUBLIC_URL}/${key}`\\n90\\t    }\\n91\\t    const isProd = process.env.NODE_ENV === \\'production\\'\\n92\\t    return isProd ? `/storage/uploads/${key}` : `/uploads/${key}`\\n93\\t  }\\n94\\t\\n95\\t  static async getPresignedUrl(key: string, contentType: string): Promise<{ url: string; fields?: Record<string, string> }> {\\n96\\t    if (!isCloudEnabled || !s3Client) {\\n97\\t      // Local fallback doesn\\'t support pre-signed URLs in the same way\\n98\\t      return { url: `/api/upload/direct?key=${key}&type=${contentType}` }\\n99\\t    }\\n100\\t\\n101\\t    const command = new PutObjectCommand({\\n102\\t      Bucket: R2_BUCKET,\\n103\\t      Key: key,\\n104\\t      ContentType: contentType,\\n105\\t    })\\n106\\t\\n107\\t    const url = await getSignedUrl(s3Client, command, { expiresIn: 3600 })\\n108\\t    return { url }\\n109\\t  }\\n110\\t}\\n111\\t'}, {'role': 'assistant', 'content': '', 'reasoning_content': 'We need to adjust the storage system to have a local store option that stores files in the system temp directory (user\\'s own computer) when LOCAL_STORE=true, otherwise use server-based (R2 or fallback to /public or storage). The user wants hybrid system: don\\'t remove /public folder fallback or R2 storage if configured, just add env that tells local_store if true store on user\\'s own computer temp storage if not use server base config.\\n\\nWe see the current code in storage.ts has isCloudEnabled based on R2 env vars. It uploads to R2 if enabled else local fallback using getStoragePath which uses getStorageRoot (from storage-utils.ts) which retur