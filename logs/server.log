deos)\\n46\\t        .set({ status: \"processing\", updatedAt: Date.now() })\\n47\\t        .where(eq(videos.id, videoId))\\n48\\t\\n49\\t      // Adaptive Bitrate Strategy (1080p, 720p, 480p)'}, {'role': 'assistant', 'content': '', 'reasoning_content': 'We need to fix the transcode worker as well: it already uses getStoragePath, good.\\n Now check the export worker.\\n', 'tool_calls': [{'id': 'chatcmpl-tool-8e9029d6ca1a530a', 'type': 'function', 'function': {'name': 'Read', 'arguments': '{\"file_path\": \"D:\\\\\\\\Code\\\\\\\\yout\\\\\\\\src\\\\\\\\lib\\\\\\\\queue\\\\\\\\workers\\\\\\\\export-worker.ts\"}'}}]}, {'role': 'tool', 'tool_call_id': 'chatcmpl-tool-8e9029d6ca1a530a', 'content': '1\\timport { Worker, Job } from \"bullmq\"\\n2\\timport Redis from \"ioredis\"\\n3\\timport { db } from \"@/lib/db\"\\n4\\timport { videos } from \"@/lib/db/schema\"\\n5\\timport { eq } from \"drizzle-orm\"\\n6\\timport pino from \"pino\"\\n7\\timport { spawn } from \"child_process\"\\n8\\timport ffmpegStatic from \"ffmpeg-static\"\\n9\\timport path from \"path\"\\n10\\timport fs from \"fs\"\\n11\\timport { VideoProject } from \"@/types/video\"\\n12\\t\\n13\\tconst logger = pino({ level: \"info\" })\\n14\\tconst connection = new Redis(process.env.REDIS_URL || \"redis://localhost:6379\")\\n15\\t\\n16\\texport class ExportWorker {\\n17\\t  private worker: Worker\\n18\\t\\n19\\t  constructor() {\\n20\\t    this.worker = new Worker(\\n21\\t      \"export-queue\",\\n22\\t      async (job: Job) => {\\n23\\t        await this.processExport(job)\\n24\\t      },\\n25\\t      {\\n26\\t        connection,\\n27\\t        concurrency: 1,\\n28\\t      }\\n29\\t    )\\n30\\t  }\\n31\\t\\n32\\t  private async processExport(job: Job) {\\n33\\t    const { videoId, project }: { videoId: string, project: VideoProject } = job.data\\n34\\t    const { getStoragePath } = await import(\"@/lib/storage-utils\")\\n35\\t    const exportDir = getStoragePath(\"exports\")\\n36\\t    if (!fs.existsSync(exportDir)) fs.mkdirSync(exportDir, { recursive: true })\\n37\\t\\n38\\t    const outputPath = path.join(exportDir, `${videoId}-final.mp4`)\\n39\\t    const ffmpegPath = ffmpegStatic || \"ffmpeg\"\\n40\\t\\n41\\t    try {\\n42\\t      await db.update(videos).set({ status: \"processing\" }).where(eq(videos.id, videoId))\\n43\\t\\n44\\t      const inputs: string[] = []\\n45\\t      let filterComplex = \"\"\\n46\\t      let inputIdx = 0\\n47\\t\\n48\\t      // PRE-PROCESS CLIPS & TRANSITIONS\\n49\\t      project.tracks.forEach(track => {\\n50\\t        track.clips.forEach(clip => {\\n51\\t          const inputPath = getStoragePath(\"uploads\", clip.assetId || \"\")\\n52\\t          if (fs.existsSync(inputPath)) {\\n53\\t             inputs.push(\"-ss\", clip.offset.toString(), \"-t\", clip.duration.toString(), \"-i\", inputPath)\\n54\\t             \\n55\\t             const volume = clip.volume ?? 1\\n56\\t             const fadeDuration = 0.5 // Standard 500ms fade\\n57\\t             \\n58\\t             // Base filter for the clip: Scale, Format, and Opacity\\n59\\t             let clipFilter = `[${inputIdx}:v]setpts=PTS-STARTPTS, scale=${project.resolution.width}:${project.resolution.height}, format=yuva420p`\\n60\\t             \\n61\\t             // Apply Fade Transitions if specified\\n62\\t             if (clip.transitionIn === \"fade\") {\\n63\\t               clipFilter += `, fade=t=in:st=0:d=${fadeDuration}`\\n64\\t             }\\n65\\t             if (clip.transitionOut === \"fade\") {\\n66\\t               clipFilter += `, fade=t=out:st=${clip.duration - fadeDuration}:d=${fadeDuration}`\\n67\\t             }\\n68\\t             \\n69\\t             filterComplex += `${clipFilter}[v${inputIdx}];`\\n70\\t             filterComplex += `[${inputIdx}:a]volume=${volume}[a${inputIdx}];`\\n71\\t             inputIdx++\\n72\\t          }\\n73\\t        })\\n74\\t      })\\n75\\t\\n76\\t      // COMPOSITING ENGINE\\n77\\t      let lastVOutput = \"v0\"\\n78\\t      let lastAOutput = \"a0\"\\n79\\t      for (let i = 1; i < inputIdx; i++) {\\n80\\t          const nextVOutput = `vout${i}`\\n81\\t          const nextAOutput = `aout${i}`\\n82\\t          // Overlay clips based on their start times (simplified for this linear demo)\\n83\\t          filterComplex += `[${lastVOutput}][v${i}]overlay=eof_action=pass[${nextVOutput}];`\\n84\\t          filterComplex += `[${lastAOutput}][a${i}]amix=inputs=2[${nextAOutput}];`\\n85\\t          lastVOutput = nextVOutput\\n86\\t          lastAOutput = nextAOutput\\n87\\t      }\\n88\\t\\n89\\t      const args = [\\n90\\t        ...inputs,\\n91\\t        \"-filter_complex\", filterComplex.slice(0, -1),\\n92\\t        \"-map\", `[${lastVOutput}]`,\\n93\\t        \"-map\", `[${lastAOutput}]`,\\n94\\t        \"-c:v\", \"libx264\",\\n95\\t        \"-preset\", \"veryfast\",\\n96\\t        \"-crf\", \"22\",\\n97\\t        \"-y\",\\n98\\t        outputPath\\n99\\t      ]\\n100\\t\\n101\\t      return new Promise((resolve, reject) => {\\n102\\t        const renderProcess = spawn(ffmpegPath, args)\\n103\\t        \\n104\\t        renderProcess.stderr.on(\"data\", (data) => {\\n105\\t          const log = data.toString()\\n106\\t          const timeMatch = log.match(/time=(\\\\d{2}:\\\\d{2}:\\\\d{2}\\\\.\\\\d{2})/)\\n107\\t          if (timeMatch) {\\n108\\t             const [h, m, s] = timeMatch[1].split(\":\").map(parseFloat)\\n109\\t             const progress = Math.min(Math.round(((h * 3600 + m * 60 + s) / project.duration) * 100), 100)\\n110\\t             job.updateProgress(progress)\\n111\\t          }\\n112\\t        })\\n113\\t\\n114\\t        renderProcess.on(\"close\", async (code) => {\\n115\\t          if (code === 0) {\\n116\\t            const isProd = process.env.NODE_ENV === \"production\"\\n117\\t            await db.update(videos).set({ \\n118\\t              status: \"published\", \\n119\\t              filePath: isProd ? `/storage/exports/${videoId}-final.mp4` : `/exports/${videoId}-fina